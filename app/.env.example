# Convex
# Run `npx convex dev` to get your deployment URL
VITE_CONVEX_URL=

# Google OAuth (for Convex Auth)
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostHog Analytics (server-side via Convex)
# Get your Project API Key from PostHog > Settings > Project API Key
# Set this in Convex: npx convex env set POSTHOG_API_KEY <your-key>
POSTHOG_API_KEY=

# Google Maps static maps (optional — event pages show the map image when
# set, and fall back to a map-pin placeholder card when it's missing)
VITE_GOOGLE_MAPS_API_KEY=

# Scraper Service (for job crawling with JavaScript rendering)
# Get an API key from the scraper-service admin
# Set this in Convex: npx convex env set SCRAPER_SERVICE_API_KEY <your-key>
SCRAPER_SERVICE_API_KEY=

# Stripe (membership checkout + webhook, convex/garden/stripe.ts + convex/http.ts)
# These are read by Convex actions/http routes, NOT by Vite — set them in
# Convex, not here. See docs/runbooks/step-0-go-live.md.
# Secret key from the Stripe dashboard (test mode: sk_test_...)
# Set this in Convex: npx convex env set STRIPE_SECRET_KEY sk_test_...
STRIPE_SECRET_KEY=
# Signing secret for the /stripe/webhook endpoint (whsec_...) — only shown
# once, at endpoint creation (see scripts/stripe-bootstrap.ts --webhook)
# Set this in Convex: npx convex env set STRIPE_WEBHOOK_SECRET whsec_...
STRIPE_WEBHOOK_SECRET=
# Recurring Price ids for the three membership levels (lookup_keys
# seat_monthly / five_monthly / leader_monthly — see scripts/stripe-bootstrap.ts)
# Set these in Convex: npx convex env set STRIPE_PRICE_SEAT price_...
STRIPE_PRICE_SEAT=
# Set this in Convex: npx convex env set STRIPE_PRICE_FIVE price_...
STRIPE_PRICE_FIVE=
# Set this in Convex: npx convex env set STRIPE_PRICE_HOST price_...
STRIPE_PRICE_HOST=
# Base site URL used to build Stripe Checkout success/cancel redirects
# Set this in Convex: npx convex env set SITE_URL https://www.thegarden.app
SITE_URL=
