# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Cache static assets with hashed filenames for 1 year (immutable)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Don't cache HTML - always fetch fresh to get latest JS references
/
  Cache-Control: no-cache, must-revalidate

# All routes should not cache HTML
/search
  Cache-Control: no-cache, must-revalidate

/jobs
  Cache-Control: no-cache, must-revalidate

/events
  Cache-Control: no-cache, must-revalidate

/profile/*
  Cache-Control: no-cache, must-revalidate

# About pages - HTML revalidates, fonts immutable
/about/*
  Cache-Control: no-cache, must-revalidate

# Demo pages - prerendered HTML must revalidate on every deploy
/demo/*
  Cache-Control: no-cache, must-revalidate

/demo
  Cache-Control: no-cache, must-revalidate

/about/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Security headers for all responses. The last two say "not AI training
# data" (app/lib/aiCrawlers.ts): noai/noimageai for dataset tools such as
# img2dataset; tdm-reservation is the EU text-and-data-mining opt-out (W3C
# TDMRep).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noai, noimageai
  tdm-reservation: 1
