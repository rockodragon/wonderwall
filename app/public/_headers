# Cloudflare Pages headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Cache static assets with hashed filenames for 1 year (immutable)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Don't cache HTML - always fetch fresh to get latest JS references
/
  Cache-Control: no-cache, must-revalidate

# All routes should not cache HTML
/search
  Cache-Control: no-cache, must-revalidate

/jobs
  Cache-Control: no-cache, must-revalidate

/events
  Cache-Control: no-cache, must-revalidate

/profile/*
  Cache-Control: no-cache, must-revalidate

# About pages - HTML revalidates, fonts immutable
/about/*
  Cache-Control: no-cache, must-revalidate

# Demo pages - prerendered HTML must revalidate on every deploy
/demo/*
  Cache-Control: no-cache, must-revalidate

/demo
  Cache-Control: no-cache, must-revalidate

/about/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The badge creatives put on their own websites (lib/profileShare.ts).
/badge/*
  Cache-Control: public, max-age=86400

# Security headers for all responses. The last two say "not AI training
# data" (app/lib/aiCrawlers.ts): noai/noimageai for dataset tools such as
# img2dataset; tdm-reservation is the EU text-and-data-mining opt-out (W3C
# TDMRep).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-Robots-Tag: noai, noimageai
  tdm-reservation: 1

# The profile card other sites put in a frame (functions/embed/[handle].ts).
# Framing is allowed here and nowhere else: "! X-Frame-Options" takes off the
# DENY that /* above sets. It must come after /*: a rule further down sets
# the header again. A Function's response doesn't get these rules, so the
# function sends the same headers itself; this is the fallback. One segment
# only (:handle): a deeper path such as /embed/a/b is the app shell, which
# stays DENY. noindex joins the X-Robots-Tag above: the card repeats the
# profile, which is the page to find.
/embed/:handle
  ! X-Frame-Options
  Content-Security-Policy: frame-ancestors *
  X-Robots-Tag: noindex
